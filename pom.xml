<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.nitouge</groupId>
    <artifactId>conduit-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Conduit RPC</name>
    <description>自研Java RPC框架：自定义协议、可插拔序列化与注册中心、负载均衡、容错熔断、异步与SPI。</description>

    <!-- 聚合 + 父POM：所有子模块继承此POM -->
    <modules>
        <module>conduit-api</module>
        <module>conduit-common</module>
        <module>conduit-protocol</module>
        <module>conduit-serialization</module>
        <module>conduit-registry</module>
        <module>conduit-registry-nacos</module>
        <module>conduit-registry-zookeeper</module>
        <module>conduit-registry-etcd</module>
        <module>conduit-remoting</module>
        <module>conduit-cluster</module>
        <module>conduit-server</module>
        <module>conduit-client</module>
        <module>conduit-spring</module>
        <module>conduit-spring-boot-starter</module>
        <module>conduit-example</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- project version; override with -Drevision=... -->
        <revision>1.0.0-SNAPSHOT</revision>

        <!-- 第三方依赖版本（集中管理） -->
        <commons-lang3.version>3.14.0</commons-lang3.version>
        <commons-collections4.version>4.4</commons-collections4.version>
        <netty.version>4.1.118.Final</netty.version>
        <jackson.version>2.17.2</jackson.version>
        <kryo.version>5.6.2</kryo.version>
        <protostuff.version>1.8.0</protostuff.version>
        <nacos.version>2.3.2</nacos.version>
        <curator.version>5.9.0</curator.version>
        <jetcd.version>0.8.8</jetcd.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.12</logback.version>
        <junit.version>5.11.3</junit.version>
        <spring-boot.version>3.3.5</spring-boot.version>

        <!-- 构建插件版本 -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ===== 内部模块（统一版本，子模块引用时无需写version） ===== -->
            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-serialization</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-registry</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-registry-nacos</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-registry-zookeeper</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-registry-etcd</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-remoting</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-cluster</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-server</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-client</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-spring</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.nitouge</groupId>
                <artifactId>conduit-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ===== 第三方依赖（显式条目放在BOM导入之前，确保以本项目锁定的版本为准） ===== -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-collections4</artifactId>
                <version>${commons-collections4.version}</version>
            </dependency>

            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-all</artifactId>
                <version>${netty.version}</version>
            </dependency>

            <dependency>
                <groupId>com.esotericsoftware</groupId>
                <artifactId>kryo</artifactId>
                <version>${kryo.version}</version>
            </dependency>

            <dependency>
                <groupId>io.protostuff</groupId>
                <artifactId>protostuff-core</artifactId>
                <version>${protostuff.version}</version>
            </dependency>

            <dependency>
                <groupId>io.protostuff</groupId>
                <artifactId>protostuff-runtime</artifactId>
                <version>${protostuff.version}</version>
            </dependency>

            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-client</artifactId>
                <version>${nacos.version}</version>
            </dependency>

            <!-- ZooKeeper注册中心（Curator） -->
            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-framework</artifactId>
                <version>${curator.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-recipes</artifactId>
                <version>${curator.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-test</artifactId>
                <version>${curator.version}</version>
            </dependency>

            <!-- Etcd注册中心（jetcd） -->
            <dependency>
                <groupId>io.etcd</groupId>
                <artifactId>jetcd-core</artifactId>
                <version>${jetcd.version}</version>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>

            <!-- ===== BOM导入 ===== -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- 所有模块默认继承：日志门面 + 单元测试 -->
    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!-- Mockito inline mock maker 通过动态 attach 注入 agent；JDK 9+ 默认禁止
                             self-attach，会导致 Spring Boot 测试初始化 Mockito 失败。
                             这里仅对测试 JVM 放开，不影响生产运行时。 -->
                        <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- Resolve ${revision} in published POMs while keeping source POMs CI-friendly. -->
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
